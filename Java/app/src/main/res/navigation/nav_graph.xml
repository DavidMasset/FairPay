<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/walletFragment">

    <fragment
        android:id="@+id/operacionesFragment"
        android:name="es.ifp.fairpay.fragments.OperacionesFragment"
        android:label="fragment_operaciones"
        tools:layout="@layout/fragment_operaciones" >
        <action
            android:id="@+id/action_operacionesFragment_to_enviarDineroFragment"
            app:destination="@id/enviarDineroFragment" />
        <action
            android:id="@+id/action_operacionesFragment_to_solicitarDineroFragment2"
            app:destination="@id/solicitarDineroFragment2" />
    </fragment>
    <fragment
        android:id="@+id/perfilFragment"
        android:name="es.ifp.fairpay.fragments.PerfilFragment"
        android:label="fragment_perfil"
        tools:layout="@layout/fragment_perfil" />
    <fragment
        android:id="@+id/movimientosFragment"
        android:name="es.ifp.fairpay.fragments.MovimientosFragment"
        android:label="fragment_movimientos"
        tools:layout="@layout/fragment_movimientos" />
    <fragment
        android:id="@+id/agendaFragment"
        android:name="es.ifp.fairpay.fragments.AgendaFragment"
        android:label="fragment_agenda"
        tools:layout="@layout/fragment_agenda" >
        <action
            android:id="@+id/action_agendaFragment_to_anadirContactoFragment"
            app:destination="@id/anadirContactoFragment" />
        <action
            android:id="@+id/action_agendaFragment_to_contactoFragment"
            app:destination="@id/contactoFragment" />
    </fragment>
    <fragment
        android:id="@+id/walletFragment"
        android:name="es.ifp.fairpay.fragments.WalletFragment"
        android:label="fragment_wallet"
        tools:layout="@layout/fragment_wallet" />
    <fragment
        android:id="@+id/anadirContactoFragment"
        android:name="es.ifp.fairpay.fragments.AnadirContactoFragment"
        android:label="fragment_anadir_contacto"
        tools:layout="@layout/fragment_anadir_contacto" />
    <fragment
        android:id="@+id/contactoFragment"
        android:name="es.ifp.fairpay.fragments.ContactoFragment"
        android:label="fragment_contacto"
        tools:layout="@layout/fragment_contacto" >
        <action
            android:id="@+id/action_contactoFragment_to_eliminarContactoFragment"
            app:destination="@id/eliminarContactoFragment" />
    </fragment>
    <fragment
        android:id="@+id/eliminarContactoFragment"
        android:name="es.ifp.fairpay.fragments.EliminarContactoFragment"
        android:label="fragment_eliminar_contacto"
        tools:layout="@layout/fragment_eliminar_contacto" >
        <action
            android:id="@+id/action_eliminarContactoFragment_to_agendaFragment"
            app:destination="@id/agendaFragment" />
    </fragment>
    <fragment
        android:id="@+id/enviarDineroFragment"
        android:name="es.ifp.fairpay.fragments.EnviarDineroFragment"
        android:label="fragment_enviar_dinero"
        tools:layout="@layout/fragment_enviar_dinero" />
    <fragment
        android:id="@+id/solicitarDineroFragment2"
        android:name="es.ifp.fairpay.fragments.SolicitarDineroFragment"
        android:label="fragment_solicitar_dinero"
        tools:layout="@layout/fragment_solicitar_dinero" />
    <fragment
        android:id="@+id/confirmarOperacionFragment2"
        android:name="es.ifp.fairpay.fragments.ConfirmarOperacionFragment"
        android:label="fragment_confirmar_operacion"
        tools:layout="@layout/fragment_confirmar_operacion" />

</navigation>